# Vorlage für die Produktion: auf dem Server nach deploy/.env kopieren und ausfüllen.
# Niemals die ausgefüllte .env committen.

# --- Domain -----------------------------------------------------------------
DOMAIN=raumbelegung.example.org

# --- Images (aus GitHub Container Registry) ---------------------------------
WEB_IMAGE=ghcr.io/OWNER/raumbelegung-web:latest
BACKEND_IMAGE=ghcr.io/OWNER/raumbelegung-backend:latest

# --- Datenbank ---------------------------------------------------------------
POSTGRES_USER=raumbelegung
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=raumbelegung

# --- Backend -----------------------------------------------------------------
SECRET_KEY=                 # openssl rand -hex 32  (signiert Verify-/Reset-Tokens)
DEFAULT_TIMEZONE=Europe/Berlin
# DATABASE_URL, FRONTEND_URL, COOKIE_SECURE, MAIL_BACKEND, ENABLE_DOCS setzt
# docker-compose.prod.yml automatisch.

# --- E-Mail (EU-Anbieter, z. B. Brevo oder Mailjet) ---------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=Raumbelegung <noreply@raumbelegung.example.org>

# --- Backups (restic) ---------------------------------------------------------
# Hetzner Object Storage (S3-kompatibel):
RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/BUCKET/raumbelegung
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=            # openssl rand -base64 32 — GUT AUFBEWAHREN, ohne geht kein Restore
