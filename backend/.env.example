# Lokale Entwicklung: nach backend/.env kopieren (cp .env.example .env).
# Für die Produktion gilt stattdessen /.env.example im Repo-Root.

DATABASE_URL=postgresql+asyncpg://raumbelegung:raumbelegung@localhost:5432/raumbelegung
# Ohne Docker geht auch SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

SECRET_KEY=dev-only-secret-not-for-production-0123456789
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
ENABLE_DOCS=true
RATE_LIMIT_ENABLED=false

# Mails gehen an Mailpit (http://localhost:8025). Ohne Docker: MAIL_BACKEND=console
MAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=Raumbelegung <noreply@localhost>
